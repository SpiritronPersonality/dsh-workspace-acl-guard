{
  "name": "dsh-workspace-acl-guard",
  "version": "0.1.1",
  "description": "只读的 DSH 插件：检测并记录 Windows 沙箱在工作区根上留下的 ACL 副作用，提供状态检查、扫描、基线日志和系统提示预警，不写任何 ACL。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "assets/**",
    "patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "docs/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "selftest": "node scripts/selftest.mjs"
  },
  "engines": {
    "node": ">=22.15"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "windows",
    "acl",
    "sandbox",
    "diagnostics"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpiritronPersonality/dsh-workspace-acl-guard.git"
  },
  "bugs": {
    "url": "https://github.com/SpiritronPersonality/dsh-workspace-acl-guard/issues"
  },
  "homepage": "https://github.com/SpiritronPersonality/dsh-workspace-acl-guard#readme",
  "author": "SpiritronPersonality"
}
